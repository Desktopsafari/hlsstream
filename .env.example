# Copy to .env.local for local overrides (not committed).
# In Vercel: Project Settings -> Environment Variables.
NEXT_PUBLIC_HLS_STREAM_URL=https://stream.desktopsafari.com/hls/stream.m3u8

# Web Push (phone/browser notifications). Generate once with
# `npx web-push generate-vapid-keys`; never commit the private key.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:desktopsafari@gmail.com
# Secret the VPS timer sends to /api/cron/send-due-push (separate from CRON_SECRET).
# PUSH_CRON_SECRET=

# Capture (clips and photos). The capture service runs on the VPS (vps/capture/).
# CAPTURE_SECRET is shared with /etc/capture/capture.env on the VPS (32+ chars);
# CAPTURE_CRON_SECRET is what the VPS cron sends to /api/cron/cleanup-captures.
# CAPTURE_SERVICE_URL=https://stream.desktopsafari.com/capture-api
# CAPTURE_SECRET=
# CAPTURE_CRON_SECRET=
