# Copy to .env.local for local overrides (not committed).
# In Vercel: Project Settings -> Environment Variables.
NEXT_PUBLIC_HLS_STREAM_URL=https://stream.desktopsafari.com/hls/stream.m3u8

# Web Push (phone/browser notifications). Generate once with
# `npx web-push generate-vapid-keys`; never commit the private key.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:desktopsafari@gmail.com
# Secret the VPS timer sends to /api/cron/send-due-push (separate from CRON_SECRET).
# PUSH_CRON_SECRET=
