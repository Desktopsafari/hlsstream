# /etc/capture/capture.env on the VPS (root, mode 600). Names only here;
# CAPTURE_SECRET must match CAPTURE_SECRET in Vercel (at least 32 characters).
CAPTURE_SECRET=
CAPTURE_PORT=3002
# Stream keys with a capture-buffer@<key> instance, comma separated.
CAPTURE_STREAMS=main
CAPTURE_BUFFER_DIR=/var/lib/capture/buffer
CAPTURE_FILES_DIR=/var/lib/capture/files
# New captures are refused (HTTP 507) below this much free disk.
CAPTURE_MIN_FREE_GB=10
